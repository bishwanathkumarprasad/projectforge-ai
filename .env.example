# =========================================================
# ProjectForge AI — Environment Configuration Template
# =========================================================

# Google Gemini API Key (Get from https://aistudio.google.com/)
# In Google Cloud Run production, inject this via Google Cloud Secret Manager!
# If left blank, ProjectForge AI automatically runs in authentic Demo Mode.
GEMINI_API_KEY=

# Preferred Gemini Model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Node Environment
NODE_ENV=production

# Server Port (Google Cloud Run automatically sets PORT=8080)
PORT=8080

# Host binding (Cloud Run requires binding to 0.0.0.0)
HOST=0.0.0.0

# Rate Limiting for AI Generation (requests per window)
AI_RATE_LIMIT=15
AI_RATE_WINDOW_MS=60000

# Timeout for Gemini API calls in milliseconds (prevents hanging sockets)
GEMINI_TIMEOUT_MS=25000

# Client URL (Optional in production since single-container serves frontend & backend on same origin)
CLIENT_URL=
